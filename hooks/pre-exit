#!/bin/bash

set -euo pipefail

# The environment hook gives the job its own gcloud configuration directory.
# The directory holds the credentials of the activated service account, so it
# must be removed at the end of the job.
if [ -v BUILDKITE_PLUGIN_GCP_SECRET_MANAGER_CLOUDSDK_CONFIG ] && [[ -n "${BUILDKITE_PLUGIN_GCP_SECRET_MANAGER_CLOUDSDK_CONFIG}" ]]; then
  echo "--- :googlecloud::key: Removing the gcloud configuration of this job"

  if ! rm -rf "${BUILDKITE_PLUGIN_GCP_SECRET_MANAGER_CLOUDSDK_CONFIG}"; then
    echo "Failed to remove ${BUILDKITE_PLUGIN_GCP_SECRET_MANAGER_CLOUDSDK_CONFIG}"
    echo "The service account credentials stay on this agent."
    exit 1
  fi
fi
